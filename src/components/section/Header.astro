---
import Navigation from "./Navigation.astro";

const { lang } = Astro.props;
---

<header class="bg-white shadow-md sticky top-0 z-50">
  <div class="flex justify-between items-center p-4 md:p-6 max-w-7xl mx-auto">
    <div class="logo font-bold text-xl text-blue-600">MyPortfolio</div>

    <nav class="hidden md:block">
      <Navigation lang={lang} />
    </nav>

    <div class="flex items-center gap-4">
      <div class="language-switcher flex gap-1 text-sm">
        <a
          href="/el/"
          class={`px-2 py-1 border rounded ${lang === "el" ? "bg-blue-600 text-white" : "text-gray-600"}`}
          >EL</a
        >
        <a
          href="/en/"
          class={`px-2 py-1 border rounded ${lang === "en" ? "bg-blue-600 text-white" : "text-gray-600"}`}
          >EN</a
        >
      </div>

      <button id="menu-toggle" class="md:hidden p-2 text-gray-600">
        <svg
          class="w-6 h-6"
          fill="none"
          stroke="currentColor"
          viewBox="0 0 24 24"
          ><path
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
            d="M4 6h16M4 12h16M4 18h16"></path></svg
        >
      </button>
    </div>
  </div>

  <div id="mobile-menu" class="hidden bg-white border-t p-4 flex-col gap-4">
    <Navigation lang={lang} />
  </div>
</header>

<script>
  const btn = document.getElementById("menu-toggle");
  const menu = document.getElementById("mobile-menu");

  btn?.addEventListener("click", () => {
    menu?.classList.toggle("hidden");
  });
  const mediaQuery = window.matchMedia("(min-width: 768px)");

  function handleTabletChange(e: MediaQueryListEvent | MediaQueryList) {
    if (e.matches) {
      menu?.classList.add("hidden");
      menu?.classList.remove("flex");
    }
  }

  mediaQuery.addEventListener("change", handleTabletChange);

  handleTabletChange(mediaQuery);
</script>
