---
const { lang } = Astro.props;
const baseUrl = `/${lang}`;
const content = {
  el: {
    home: "Αρχική",
    about: "Σχετικά",
    projects: "Έργα",
    contact: "Επικοινωνία",
  },
  en: {
    home: "Home",
    about: "About",
    projects: "Projects",
    contact: "Contact",
  },
};

const t = content[lang as keyof typeof content];
---

<div class="nav-links flex gap-6 font-medium text-gray-700">
  <a href={`${baseUrl}/`} class="hover:text-blue-500 transition">
    {t.home}
  </a>
  <a href={`${baseUrl}/#about`} class="hover:text-blue-500 transition">
    {t.about}
  </a>
  <a href={`${baseUrl}/#projects`} class="hover:text-blue-500 transition">
    {t.projects}
  </a>
  <a href={`${baseUrl}/#contact`} class="hover:text-blue-500 transition">
    {t.contact}
  </a>
</div>
