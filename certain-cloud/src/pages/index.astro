---
//main page.nesting components inside MainLayout
import MainLayout from "../layouts/MainLayout.astro";

import Hero from "../components/section/Hero.astro";

import AboutMe from "../components/section/AboutMe.svelte";

import Projects from "../components/section/Projects.svelte";

import ContactForm from "../components/section/ContactForm.svelte";

const lang = "el";
---

<MainLayout title="Portfolio | WebEleven Assignment">
  <Hero lang={lang} />

  <AboutMe client:load lang={lang} />

  <Projects client:load lang={lang} />

  <ContactForm client:load lang={lang} />
</MainLayout>
